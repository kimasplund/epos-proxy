# ePOS Printer Configuration
# Format: printer_name = ip_address_or_url
#
# Examples:
# 
# 1. HTTP Printers (default if protocol not specified)
# kitchen = 192.168.1.100
# bar = 192.168.1.101
# 
# 2. HTTPS Printers (explicitly specify https://)
# reception = https://192.168.1.102
# office = https://192.168.1.103
#
# 3. With Port Specification
# warehouse = 192.168.1.104:8008
# shipping = https://192.168.1.105:8443
#
# NOTE: Do NOT include the .epos suffix in the name - this will be added automatically
# by the DNS server. All printers will be accessible at https://printer-name.epos/
#
# Changes to this file are automatically detected and applied immediately!
# No need to restart the container when adding, removing, or updating printers.
#
# The DNS server will also be updated automatically to resolve the printer hostnames.
# DNS records have a short TTL (60 seconds) to ensure changes propagate quickly.

# HTTP Printers (Will be accessed through the proxy as HTTPS)
printer1 = 192.168.14.217
printer2 = 192.168.14.101

# HTTPS Printers (Already support HTTPS natively, but benefit from DNS and logging)
secure-printer1 = https://192.168.14.218
secure-printer2 = https://192.168.14.102

# Printers with non-standard ports
kitchen-printer = 192.168.14.220:8080
office-printer = https://192.168.14.221:8443 